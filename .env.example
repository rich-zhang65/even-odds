# Read by `npm run db:up`, which starts a local Postgres to match. Copy to .env
# and point at Neon outside local dev. 5433 rather than 5432, which an
# installed Postgres may already hold.
DATABASE_URL=postgres://even_odds:even_odds@localhost:5433/even_odds

# Everything below is optional locally and set on the hosts when deployed; see
# "Deploying" in the README.

# Signs the tickets that let a browser into the game server. Must be the same
# on the web app and the game server. Locally a fixed value is used if unset.
# SOCKET_SECRET=

# The game server's address, as the browser reaches it. Read at build time.
# NEXT_PUBLIC_SERVER_URL=http://localhost:4000

# The web app's address, the only site the game server accepts. Game server only.
# ALLOWED_ORIGIN=

# The password for both accounts, used only by `npm run db:seed`.
# SEED_PASSWORD=
